model erp_cierre_periodo_saldos {
  id                  BigInt              @id @default(autoincrement())
  cierre_id           Int
  producto_id         Int
  almacen_id          Int
  cantidad            Decimal             @default(0.0000) @db.Decimal(10, 4)
  costo_unitario      Decimal             @default(0.0000) @db.Decimal(15, 4)
  valor_total         Decimal             @default(0.0000) @db.Decimal(15, 4)
  erp_cierres_periodo erp_cierres_periodo @relation(fields: [cierre_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "erp_cierre_periodo_saldos_ibfk_1")
  erp_productos       erp_productos       @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "erp_cierre_periodo_saldos_ibfk_2")
  erp_almacenes       erp_almacenes       @relation(fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "erp_cierre_periodo_saldos_ibfk_3")

  @@index([almacen_id], map: "almacen_id")
  @@index([cierre_id], map: "idx_cierre_periodo_saldos_cierre")
  @@index([producto_id], map: "producto_id")
}

model erp_cierres_periodo {
  id                                                                   Int                         @id @default(autoincrement())
  anio                                                                 Int                         @db.SmallInt
  mes                                                                  Int                         @db.TinyInt
  fecha_cierre                                                         DateTime                    @db.Date
  estado                                                               erp_cierres_periodo_estado? @default(cerrado)
  observaciones                                                        String?                     @db.Text
  usuario_cierre_id                                                    Int?
  fecha_cierre_registro                                                DateTime?                   @default(now()) @db.Timestamp(0)
  usuario_reapertura_id                                                Int?
  fecha_reapertura                                                     DateTime?                   @db.Timestamp(0)
