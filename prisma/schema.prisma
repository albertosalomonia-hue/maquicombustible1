model erp_auditoria {
  id             BigInt    @id @default(autoincrement())
  usuario_id     Int?
  usuario_nombre String?   @db.VarChar(100)
  fecha          DateTime? @default(now()) @db.Timestamp(0)
  ip             String?   @db.VarChar(45)
  modulo         String    @db.VarChar(50)
  accion         String    @db.VarChar(50)
  tabla          String?   @db.VarChar(50)
  registro_id    String?   @db.VarChar(50)
  valor_anterior Json?
  valor_nuevo    Json?

  @@index([fecha], map: "idx_audit_fecha")
  @@index([modulo], map: "idx_audit_modulo")
