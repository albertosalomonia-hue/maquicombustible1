# Conexión a MySQL (Prisma). En Vercel: Settings > Environment Variables.
# Usuario/clave con caracteres especiales deben ir codificados (URL-encoded).
DATABASE_URL="mysql://usuario:clave@host:3306/base"
# true si el MySQL remoto exige SSL/TLS
DB_SSL=false
# Conexiones por instancia serverless: mantener bajo (2-5) para no agotar max_connections
DB_CONNECTION_LIMIT=3

# Auth (JWT)
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# Sitios que pueden embeber la app en un iframe (separados por espacios). Vacío = solo mismo origen.
FRAME_ANCESTORS=
